generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders
//
// The product catalog itself is static (src/lib/products.ts) — there's no
// admin dashboard, so pricing/specs are edited in code. Orders are persisted
// here for record-keeping and to make the Stripe webhook idempotent; the
// team is notified of each new order by email rather than through a UI.
// ─────────────────────────────────────────────────────────────────────────────
model Order {
  id                Int      @id @default(autoincrement())
  stripeSessionId   String   @unique @map("stripe_session_id")
  customerEmail     String   @map("customer_email")
  customerName      String?  @map("customer_name")
  shippingAddress   Json?    @map("shipping_address")
  totalCents        Int      @map("total_cents")
  currency          String   @default("usd")
  status            String   @default("paid") // paid | fulfillment-notified
  createdAt         DateTime @default(now()) @map("created_at")

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         Int    @id @default(autoincrement())
  orderId    Int    @map("order_id")
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSlug String @map("product_slug")
  name       String // snapshot at time of purchase
  priceCents Int    @map("price_cents")
  quantity   Int

  @@index([orderId])
  @@map("order_items")
}
