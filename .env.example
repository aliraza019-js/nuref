# Pooled connection string used by the running app (e.g. Supabase pooler on :6543).
DATABASE_URL="postgresql://user:password@localhost:5432/nuref"

# Direct (non-pooled) connection string used for migrations / `npm run db:push`.
DIRECT_URL="postgresql://user:password@localhost:5432/nuref"

# HMAC secret used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me"
