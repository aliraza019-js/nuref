# Pooled connection string used by the running app (e.g. Supabase pooler on :6543).
DATABASE_URL="postgresql://user:password@localhost:5432/nuref"

# Direct (non-pooled) connection string used for migrations / `npm run db:push`.
DIRECT_URL="postgresql://user:password@localhost:5432/nuref"

# Public site URL, used to build Stripe Checkout success/cancel redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe (test mode keys while developing: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen` locally, or the endpoint's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend (https://resend.com/api-keys) — used for the Contact Us form and order notifications.
RESEND_API_KEY="re_..."
# Must be on a domain verified in Resend before sending in production.
RESEND_FROM_EMAIL="Nuref <orders@yourdomain.com>"
# Inbox that receives Contact Us / sales inquiries.
SALES_CONTACT_EMAIL="sales@yourdomain.com"
# Inbox that receives new paid-order notifications for drop-ship fulfillment.
ORDER_NOTIFICATION_EMAIL="orders@yourdomain.com"
